#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "rbconfig"
require "rubygems/package"
require "tmpdir"

root = File.expand_path("..", __dir__)
ruby_files = Dir.glob(File.join(root, "{lib,exe,bin,test,examples,script}/**/*.rb"), File::FNM_DOTMATCH)
ruby_files.concat(%w[bin/test bin/check exe/specproof].map { |path| File.join(root, path) })
ruby_files.uniq.sort.each do |path|
  output, status = Open3.capture2e(RbConfig.ruby, "-c", path)
  next if status.success?

  warn output
  exit status.exitstatus
end

output, status = Open3.capture2e(
  RbConfig.ruby, "bin/test", "test/skill_assets_test.rb", "test/packaging_test.rb", chdir: root
)
puts output
exit status.exitstatus unless status.success?

Dir.mktmpdir("specproof-gem-") do |directory|
  gem_path = File.join(directory, "specproof.gem")
  Dir.chdir(root) do
    specification = Gem::Specification.load(File.join(root, "specproof.gemspec"))
    Gem::Package.build(specification, false, false, gem_path)
  end
  abort "gem build did not create #{gem_path}" unless File.file?(gem_path)
  abort "gem build omitted its library" unless Gem::Package.new(gem_path).contents.include?("lib/specproof.rb")
end
