module SpecProof
  VERSION: String

  def self.load: (Array[String] paths, ?rbs: Array[String], ?targets: Array[String]) -> Array[Specification]
  def self.check: (Array[Specification] specifications) -> Array[Finding | CombinationFinding]
  def self.plan: (Array[Specification] specifications, ?criterion: String) -> Array[Obligation | PairObligation]
  def self.suggest: (Array[Specification] specifications, report: Hash[String, untyped]) -> SuggestionResult

  class Error < StandardError
  end

  class ConfigurationError < Error
    attr_reader code: String
    attr_reader source: Source?
    attr_reader path: String?
  end

  class Specification
    attr_reader target: String
    attr_reader inputs: Hash[Symbol, Input]
    attr_reader exclusions: Hash[Symbol, Exclusion]
    attr_reader combination_group: CombinationGroup?
    attr_reader source: Source
  end

  class Exclusion
    attr_reader name: Symbol
    attr_reader reason: String
    attr_reader source: Source
  end

  class Input
    attr_reader name: Symbol
    attr_reader domain: IntegerDomain | FiniteDomain
    attr_reader partitions: Array[Partition]
    attr_reader exhaustive: bool
    attr_reader disjoint: bool
    attr_reader source: Source
    attr_reader type_constraint: ScalarTypeConstraint?
    attr_reader type_sources: Array[Source]
    def sources: () -> Array[Source]
  end

  class Partition
    attr_reader name: Symbol
    attr_reader domain: IntegerDomain | FiniteDomain
    attr_reader source: Source
  end

  class IntegerDomain
    attr_reader lower: Integer
    attr_reader upper: Integer
    def self.from_range: (Range[Integer] range) -> IntegerDomain
    def include?: (untyped value) -> bool
  end

  class FiniteDomain
    attr_reader values: Array[nil | bool | Integer | Symbol | String]
    def include?: (untyped value) -> bool
  end

  class Source
    attr_reader path: String
    attr_reader line: Integer
    attr_reader kind: String
  end

  class ScalarTypeConstraint
    attr_reader integer_any: bool
    attr_reader values: Array[nil | bool | Integer | Symbol | String]
    def initialize: (integer_any: bool, values: Array[nil | bool | Integer | Symbol | String]) -> void
  end

  class InputTypeFact
    attr_reader target: String
    attr_reader input: Symbol
    attr_reader constraint: ScalarTypeConstraint
    attr_reader source: Source
    def initialize: (target: String, input: Symbol, constraint: ScalarTypeConstraint, source: Source) -> void
  end

  module TypeConstraints
    def self.include?: (ScalarTypeConstraint constraint, untyped value) -> bool
    def self.finite_domain: (ScalarTypeConstraint constraint) -> FiniteDomain?
    def self.first_excluded: (ScalarTypeConstraint constraint, IntegerDomain | FiniteDomain domain) -> untyped
    def self.union: (Array[ScalarTypeConstraint] constraints) -> ScalarTypeConstraint
  end

  class Finding
    attr_reader code: Symbol
    attr_reader target: String
    attr_reader input: Symbol
    attr_reader witness: untyped
    attr_reader sources: Array[Source]
  end

  class CombinationFinding
    attr_reader code: Symbol
    attr_reader target: String
    attr_reader inputs: Array[Symbol]
    attr_reader sources: Array[Source]
  end

  class Obligation
    attr_reader id: String
    attr_reader target: String
    attr_reader input: Symbol
    attr_reader value: nil | bool | Integer | Symbol | String
    attr_reader reasons: Array[String]
    attr_reader sources: Array[Source]
  end

  class PairObligation
    attr_reader id: String
    attr_reader target: String
    attr_reader inputs: Hash[Symbol, nil | bool | Integer | Symbol | String | PartitionLevel]
    attr_reader reasons: Array[String]
    attr_reader sources: Array[Source]
  end

  class CombinationGroup
    attr_reader inputs: Array[Symbol]
    attr_reader forbidden: Array[ForbiddenAssignment]
    attr_reader source: Source
  end

  class ForbiddenAssignment
    attr_reader assignments: Hash[Symbol, nil | bool | Integer | Symbol | String | PartitionReference]
    attr_reader source: Source
  end

  class PartitionReference
    attr_reader name: Symbol
    def initialize: (Symbol name) -> void
  end

  class CombinationSpace
    attr_reader pairs: Array[Hash[Symbol, nil | bool | Integer | Symbol | String]]
    attr_reader excluded_pairs: Array[Hash[Symbol, nil | bool | Integer | Symbol | String]]
    attr_reader allowed_count: Integer
    attr_reader allowed_assignments: Array[Hash[Symbol, nil | bool | Integer | Symbol | String]]
    attr_reader sources: Array[Source]
    def initialize: (Specification specification) -> void
    def allowed?: (Hash[Symbol, nil | bool | Integer | Symbol | String] arguments) -> bool
  end

  class PartitionLevel
    attr_reader name: Symbol
    attr_reader lower: Integer
    attr_reader upper: Integer
    def initialize: (name: Symbol, lower: Integer, upper: Integer) -> void
    def include?: (untyped value) -> bool
    def representative: () -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def sort_key: () -> Array[untyped]
  end

  class PartitionSpace
    attr_reader pairs: Array[Hash[Symbol, nil | bool | Integer | Symbol | String | PartitionLevel]]
    attr_reader excluded_pairs: Array[Hash[Symbol, nil | bool | Integer | Symbol | String | PartitionLevel]]
    attr_reader allowed_count: Integer
    attr_reader allowed_assignments: Array[Hash[Symbol, nil | bool | Integer | Symbol | String | PartitionLevel]]
    attr_reader sources: Array[Source]
    def self.for_specification: (Specification specification, ?criterion: String?, ?validate_geometry: bool) -> (PartitionSpace | CombinationSpace)
    def initialize: (Specification specification, ?validate_geometry: bool) -> void
    def allowed?: (Hash[Symbol, nil | bool | Integer | Symbol | String] arguments) -> bool
  end

  class CoverageReport
    attr_reader contract_digest: String
    attr_reader missing_ids: Array[String]
    attr_reader run_id: String
    attr_reader tests_passed: bool
    attr_reader scope: Hash[String, untyped]
    attr_reader scope_snapshot: Hash[String, untyped]
    attr_reader criterion: String
    def initialize: (Hash[String, untyped] report, specifications: Array[Specification], obligations: Array[Obligation | PairObligation], ?criterion: String) -> void
  end

  class Suggestion
    attr_reader id: String
    attr_reader target: String
    attr_reader inputs: Hash[Symbol, nil | bool | Integer | Symbol | String]
    attr_reader covers: Array[String]
    attr_reader unassigned_inputs: Array[Symbol]
    attr_reader sources: Array[Source]
  end

  class SuggestionResult
    attr_reader suggestions: Array[Suggestion]
    attr_reader contract_digest: String
    attr_reader source_run_id: String
    attr_reader source_tests_passed: bool
    attr_reader source_scope: Hash[String, untyped]
    attr_reader missing_count: Integer
    attr_reader criterion: String
    attr_reader strategy: String
    def initialize: (suggestions: Array[Suggestion], contract_digest: String, source_run_id: String, source_tests_passed: bool, source_scope: Hash[String, untyped], missing_count: Integer, ?criterion: String, ?strategy: String) -> void
  end

  def self.define: (String | Method | UnboundMethod target) { () -> void } -> Specification
end

module SpecProof::TargetName
  def self.normalize: (String | Method | UnboundMethod target, ?source: SpecProof::Source?) -> String
  def self.parse: (String target) -> [String, Symbol, :instance | :singleton]
end

module Specproof
  VERSION: String
  def self.load: (Array[String] paths, ?rbs: Array[String], ?targets: Array[String]) -> Array[SpecProof::Specification]
  def self.check: (Array[SpecProof::Specification] specifications) -> Array[SpecProof::Finding | SpecProof::CombinationFinding]
  def self.plan: (Array[SpecProof::Specification] specifications, ?criterion: String) -> Array[SpecProof::Obligation | SpecProof::PairObligation]
  def self.suggest: (Array[SpecProof::Specification] specifications, report: Hash[String, untyped]) -> SpecProof::SuggestionResult
  def self.define: (String | Method | UnboundMethod target) { () -> void } -> SpecProof::Specification
end

module SpecProof::Minitest
  def self.install!: (specifications: Array[String], ?rbs: Array[String], ?targets: Array[String], ?output: String, ?criterion: String, ?fail_on_missing: bool) -> self
end
